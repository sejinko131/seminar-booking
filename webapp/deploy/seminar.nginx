# Replace seminar.example.invalid and certificate paths before installation.
server {
    listen 443 ssl;
    server_name seminar.example.invalid;
    ssl_certificate /etc/letsencrypt/live/seminar.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seminar.example.invalid/privkey.pem;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:8769;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
